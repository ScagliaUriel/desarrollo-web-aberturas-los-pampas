@startuml
title Modelo Entidad-Relación - Aberturas Los Pampas

entity "Usuario" as usuario {
  * id_usuario : INT <<PK>>
  --
  * nombre : VARCHAR(100)
  * email : VARCHAR(100) <<UNIQUE>>
  * clave_hash : VARCHAR(255)
  * tipo_cliente : VARCHAR(20)
  razon_social : VARCHAR(100)
  cuit : VARCHAR(15)
  * id_rol : INT <<FK>>
}

entity "Rol" as rol {
  * id_rol : INT <<PK>>
  --
  * nombre_rol : VARCHAR(50)
}

entity "Producto" as producto {
  * id_producto : INT <<PK>>
  --
  * nombre : VARCHAR(100)
  * descripcion : TEXT
  * precio : DECIMAL(10,2)
  * stock_actual : INT
  * stock_minimo : INT
  * a_medida : BOOLEAN
  * id_categoria : INT <<FK>>
  * id_proveedor : INT <<FK>>
}

entity "Categoria" as categoria {
  * id_categoria : INT <<PK>>
  --
  * nombre_categoria : VARCHAR(50)
}

entity "Proveedor" as proveedor {
  * id_proveedor : INT <<PK>>
  --
  * razon_social : VARCHAR(100)
  * telefono : VARCHAR(20)
  * email : VARCHAR(100)
}

entity "Pedido" as pedido {
  * id_pedido : INT <<PK>>
  --
  * fecha : DATETIME
  * estado_pago : VARCHAR(30)
  * estado_envio : VARCHAR(30)
  * total : DECIMAL(10,2)
  * id_usuario : INT <<FK>>
}

entity "DetallePedido" as detalle_pedido {
  * id_detalle : INT <<PK>>
  --
  * cantidad : INT
  * precio_unitario : DECIMAL(10,2)
  medida_especifica : VARCHAR(100)
  * id_pedido : INT <<FK>>
  * id_producto : INT <<FK>>
}

entity "SolicitudCotizacion" as cotizacion {
  * id_cotizacion : INT <<PK>>
  --
  * fecha_solicitud : DATETIME
  * alto : DECIMAL(5,2)
  * ancho : DECIMAL(5,2)
  * material : VARCHAR(50)
  * tipo_vidrio : VARCHAR(50)
  url_plano : VARCHAR(255)
  * estado : VARCHAR(30)
  precio_cotizado : DECIMAL(10,2)
  * id_usuario : INT <<FK>>
}

entity "Instalacion" as instalacion {
  * id_instalacion : INT <<PK>>
  --
  * fecha_programada : DATE
  * direccion : VARCHAR(200)
  * estado : VARCHAR(30)
  * id_pedido : INT <<FK>>
}

entity "OrdenCompra" as orden_compra {
  * id_orden : INT <<PK>>
  --
  * fecha_emision : DATETIME
  * estado : VARCHAR(30)
  * total : DECIMAL(10,2)
  * id_proveedor : INT <<FK>>
}

usuario }|--|| rol
usuario ||--o{ pedido
usuario ||--o{ cotizacion
producto }|--|| categoria
producto }|--|| proveedor
pedido ||--|{ detalle_pedido
producto ||--o{ detalle_pedido
pedido ||--o| instalacion
proveedor ||--o{ orden_compra

@enduml